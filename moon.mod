name = "moonbitstack/moonpool"

version = "0.3.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonpool"

license = "Apache-2.0"

keywords = [
  "pool",
  "resource-pool",
  "connection-pool",
  "object-pool",
  "backoff",
  "retry",
  "exponential-backoff",
  "flow-control",
  "circuit-breaker",
  "limits",
  "reproducible",
  "moonbit",
]

description = "Resource pools, backoff retries and flow control for MoonBit."

import {
  "moonbitstack/moondate@0.1.5",
  "moonbitstack/moonward@0.2.1",
}

source = "src"
