name = "moonbitstack/moonpool"

version = "0.3.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonpool"

license = "Apache-2.0"

keywords = [
  "pool",
  "resource-pool",
  "connection-pool",
  "object-pool",
  "backoff",
  "retry",
  "exponential-backoff",
  "flow-control",
  "circuit-breaker",
  "limits",
  "load-balancing",
  "round-robin",
  "power-of-two-choices",
  "weighted",
  "metrics",
  "observability",
  "leak-detection",
  "adaptive-concurrency",
  "concurrency-limit",
  "reproducible",
  "moonbit",
]

description = "Resource pools, backoff retries and flow control for MoonBit."

import {
  "moonbitstack/moondate@0.1.7",
  "moonbitstack/moonward@0.2.3",
}

source = "src"
