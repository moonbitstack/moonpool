// Resource pools with no I/O of their own.
//
// The pool answers which resource to hand out, whether to make another and
// which to let go, and leaves the acting to the caller. A `Ward` of moonward's
// parts can sit in front of it: a breaker that stops new connections to a
// failing backend, a bucket that spaces them out, backoff after a failed one,
// and a shedder that stops lending when the process is overloaded.
import {
  "moonbitstack/moondate",
  "moonbitstack/moonward",
}
